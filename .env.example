# DEWaS CCTV Local Edge Streaming Gateway Configuration
PORT=8554
HOST=0.0.0.0

# Optional: URL publik hasil tunneling (Cloudflare Tunnel / ngrok)
# Contoh: https://cctv-stream.mydomain.com
TUNNEL_URL=

# Auto-start otomatis saat komputer reboot/restart (true/false)
AUTO_STARTUP=true

# URL Backend VPS DEWaS
VPS_API_URL=https://api.dewas.id/api

# Pemetaan RTSP Kamera Lokal di Jaringan LAN Kantor / Lapangan
CAM_SEA_001_RTSP=rtsp://admin:admin123@192.168.1.64:554/Streaming/channels/101
# CAM_SEA_002_RTSP=rtsp://192.168.10.25:554/live/ch0
# CAM_FLOOD_01_RTSP=rtsp://192.168.10.30:554/live/ch0

# Inactivity timeout (detik) sebelum mematikan FFmpeg saat tidak ada penonton
STREAM_IDLE_TIMEOUT=60
